#!/usr/bin/env python3
"""Public setup entry point. Installation is explicit; help and plans are read-only."""
from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import http.client
import json
import os
from pathlib import Path
import platform
import re
import shlex
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
# Help/plans must not create bytecode artifacts in a source checkout or package.
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "lib"))
import update_support
import existing_gateway

FORMULA = "georgetheo99/tap/pi-shared"
MODULES = {"pi-shared", "model-gateway", "browser-worker", "local_web_search"}
OMLX_FORMULA = "jundot/omlx/omlx"
OMLX_GUIDE = "https://github.com/jundot/omlx#installation"


def run(args, *, env=None):
    sys.stdout.flush()
    sys.stderr.flush()
    subprocess.run([str(a) for a in args], check=True, env=env)


def choose(question, choices):
    print(question)
    for key, label in choices.items():
        print(f"  {key}: {label}")
    while True:
        answer = input("Choice (or cancel): ").strip().lower()
        if answer == "cancel":
            raise KeyboardInterrupt
        if answer in choices:
            return answer
        print("Select one of the listed choices.")


def loopback_url(value):
    try:
        u = urllib.parse.urlsplit(value)
        port = u.port
    except ValueError as exc:
        raise argparse.ArgumentTypeError("Invalid oMLX URL") from exc
    if (u.scheme != "http" or u.hostname not in {"127.0.0.1", "::1"}
            or u.username is not None or u.password is not None
            or u.query or u.fragment or u.path.rstrip("/") != "/v1"
            or (port is not None and not 1 <= port <= 65535)):
        raise argparse.ArgumentTypeError(
            "Use an explicit loopback URL such as http://127.0.0.1:8000/v1; "
            "remote/authenticated servers require manual configuration.")
    return value.rstrip("/")


def hardware():
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise RuntimeError("Local oMLX installation requires an Apple Silicon Mac (native arm64 shell).")
    version = platform.mac_ver()[0]
    if not version or int(version.split(".")[0]) < 15:
        raise RuntimeError("Local oMLX installation requires macOS 15 or newer.")
    total = int(subprocess.check_output(["/usr/sbin/sysctl", "-n", "hw.memsize"], text=True))
    free = shutil.disk_usage(Path.home()).free
    print(f"Hardware: {total / 2**30:.1f} GiB total RAM; {free / 2**30:.1f} GiB free disk.")
    print("Model fit depends on available RAM, quantization, context and cache; no model fit is assumed.")


def guard_fresh_omlx():
    # Never adopt a separately managed service or overwrite its settings.
    paths = [Path.home() / ".omlx", Path.home() / "Library/LaunchAgents/com.local.omlx.plist",
             Path.home() / "Library/LaunchAgents/homebrew.mxcl.omlx.plist"]
    if shutil.which("omlx") or any(p.exists() or p.is_symlink() for p in paths):
        raise RuntimeError("Existing oMLX installation/settings found; choose --omlx existing or guide. "
                           "Its service manager will not be replaced.")
    try:
        with socket.create_connection(("127.0.0.1", 8000), timeout=1):
            raise RuntimeError("Port 8000 is occupied; use an existing server or configure oMLX manually.")
    except OSError:
        pass


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise RuntimeError("oMLX redirected the request; automatic redirects are disabled.")


def discover_models(url, allow_auth_required=False):
    # Explicit numeric loopback, no proxies, redirects, credentials or model calls.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    try:
        with opener.open(url + "/models", timeout=10) as response:
            raw = response.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            raise RuntimeError("oMLX model listing exceeded the size limit.")
        data = json.loads(raw)
        if not isinstance(data, dict) or not isinstance(data.get("data"), list):
            raise ValueError
        models = data["data"]
        if any(not isinstance(m, dict) or not isinstance(m.get("id"), str) or not m["id"] for m in models):
            raise ValueError
    except urllib.error.HTTPError as exc:
        if allow_auth_required and exc.code in {401, 403}:
            print("oMLX endpoint responds and requires authentication; model readiness is not tested.")
            return
        raise RuntimeError(f"oMLX discovery returned HTTP {exc.code}; configure authentication manually if required.") from None
    except (ValueError, OSError, http.client.HTTPException) as exc:
        raise RuntimeError("Could not read a valid oMLX model listing; check URL, service and authentication.") from exc
    print(f"oMLX discovery: {len(models)} model(s); inference and Pi routing NOT verified.")
    for model in models[:50]:
        print("  " + json.dumps(model["id"], ensure_ascii=True))
    if not models:
        print("No models installed. Review download size and memory needs in oMLX /admin before downloading.")


def wait_omlx(url, allow_auth_required=False):
    # launchd start/restart is asynchronous. Retry within a bounded window,
    # rather than restarting again merely because the first connection raced.
    deadline = time.monotonic() + 60
    while True:
        try:
            if allow_auth_required:
                discover_models(url, allow_auth_required=True)
            else:
                discover_models(url)
            return
        except RuntimeError:
            if time.monotonic() >= deadline:
                raise RuntimeError("oMLX startup discovery failed; inspect brew services info omlx. "
                                   "Its service was not stopped. Check the configured URL before retrying.") from None
            time.sleep(2)


def state_path():
    return Path.home() / ".config/pi-shared/setup.json"


def write_state(value):
    path = state_path()
    for parent in (Path.home() / ".config", path.parent):
        if parent.is_symlink():
            raise RuntimeError(f"Refusing symlinked setup state directory: {parent}")
        parent.mkdir(mode=0o700, exist_ok=True)
        info = parent.stat()
        if info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise RuntimeError(f"Setup state directory must be owned by you and not group/world writable: {parent}")
    if path.is_symlink() or (path.exists() and (not path.is_file() or path.stat().st_nlink != 1
                                              or path.stat().st_uid != os.getuid())):
        raise RuntimeError("Refusing unsafe setup state file.")
    fd, name = tempfile.mkstemp(prefix=".setup-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(value, f, indent=2)
            f.write("\n")
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def guidance(args, code_root):
    if args.mode in {"cloud", "both"}:
        print("Cloud models: run pi, then /login (or configure your own provider key) and /model.")
    if args.mode in {"local", "both"}:
        print(f"oMLX installation/model management: {OMLX_GUIDE}")
        print("No model weights downloaded by pi-shared. Review size and memory fit before any download.")
        print("Local inference remains PENDING: select a model in oMLX, configure a reviewed Pi/gateway route, "
              "then test an actual response. Discovery alone does not configure Pi.")
        print(f"Gateway guidance: {code_root / 'model-gateway/docs/provider-onboarding.md'} "
              "(the HTTPS cloud onboarding generator does not support local HTTP oMLX URLs).")
    if args.recovery == "guide":
        print("pi-fallback: OPTIONAL, independent Apple Silicon recovery prototype; not installed here.")
        print("Use a separately trusted contained release (Pi/Node + Python/MLX), then run:")
        print("  pi-fallback models list\n  pi-fallback models discover\n  pi-fallback models install\n"
              "  pi-fallback doctor --tool-smoke")
        print("Review model download size first. Offline recovery is NOT ready until a real model/tool test "
              "passes without a skipped check. No published Homebrew recovery formula is assumed.")


def setup(args):
    interactive = sys.stdin.isatty() and not args.yes and not args.plan
    if state_path().is_symlink():
        raise RuntimeError("Refusing unsafe setup state file.")
    previous = read_state(allow_incomplete=True) if state_path().exists() else None
    saved_gateway = previous.get("external_gateway") if previous else None
    if saved_gateway and args.mode is None and not args.local:
        args.mode = "existing-gateway"
    if args.local:
        if args.mode not in {None, "local"}:
            raise RuntimeError("--local cannot be combined with a different --mode.")
        args.mode = "local"
    if args.mode is None:
        if not interactive:
            raise RuntimeError("Specify --mode cloud|local|both|later|existing-gateway in non-interactive mode.")
        args.mode = choose("How would you like to run models?", {
            "cloud": "Cloud providers — subscription login or API keys",
            "local": "Local models with oMLX — Apple Silicon Mac required for installation",
            "both": "Both cloud and local models", "later": "Configure models later",
            "existing-gateway": "Connect directly to an existing remote model-gateway (no local gateway)"})
    remote = args.mode == "existing-gateway"
    if saved_gateway and not remote:
        raise RuntimeError("An external gateway is already selected; refusing to discard it or mix it with local gateway setup. Reconcile the connection manually first.")
    if remote and previous and ("model-gateway" in previous["modules"] or previous.get("omlx")):
        raise RuntimeError("A local gateway/oMLX was previously selected; refusing to mix it with an external gateway. Reconcile the existing setup manually first.")
    if not remote and (args.gateway_url is not None or args.gateway_key_file is not None or args.allow_private_http):
        raise RuntimeError("Gateway connection options require --mode existing-gateway.")
    gateway = None
    if remote:
        saved = saved_gateway or {}
        url = args.gateway_url if args.gateway_url is not None else saved.get("url")
        key_file = args.gateway_key_file if args.gateway_key_file is not None else saved.get("key_file")
        if not url and interactive:
            url = input("Existing gateway base URL (HTTPS preferred; no credentials): ").strip()
            if url.lower() == "cancel":
                raise KeyboardInterrupt
        if not key_file and interactive:
            key_file = input("Absolute path to your existing private gateway key file (0600; not the key): ").strip()
            if key_file.lower() == "cancel":
                raise KeyboardInterrupt
        if not url or not key_file:
            raise RuntimeError("--mode existing-gateway requires --gateway-url and --gateway-key-file (or a saved connection).")
        allow_http = args.allow_private_http
        if allow_http is None:
            allow_http = saved.get("allow_private_http", False) if url.rstrip("/").removesuffix("/v1") == saved.get("url") else False
        if url.startswith("http://") and not allow_http and interactive:
            allow_http = choose("HTTP sends the gateway key without TLS. Is this a trusted private/Tailscale endpoint?", {
                "no": "Do not connect; use HTTPS", "yes": "Explicitly allow private HTTP"}) == "yes"
        gateway = existing_gateway.connection(url, key_file, allow_http)
    local = args.mode in {"local", "both"}
    if not local and (args.omlx or args.omlx_url):
        raise RuntimeError("oMLX options require --mode local/both or --local.")
    if local and args.omlx is None:
        args.omlx = choose("Optional oMLX setup:", {
            "existing": "Discover models on an existing local server (do not change its service)",
            "install": "Install and start a NEW oMLX Homebrew service (macOS 15+, Apple Silicon)",
            "guide": "Show instructions; configure local serving later"}) if interactive else "guide"
    if args.omlx == "existing" and not args.omlx_url:
        if not interactive:
            raise RuntimeError("--omlx existing requires --omlx-url (no port is assumed).")
        args.omlx_url = loopback_url(input("OpenAI base URL (e.g. http://127.0.0.1:8000/v1): ").strip())
    if args.omlx_url and args.omlx != "existing":
        raise RuntimeError("--omlx-url is only used with --omlx existing.")
    if args.recovery is None:
        args.recovery = choose("Optional independent recovery kit:", {
            "skip": "Skip (default; no recovery download)",
            "guide": "Show pi-fallback prototype preparation instructions"}) if interactive else "skip"

    env = dict(os.environ)
    if saved_gateway:
        # A rerun is an explicit catalog refresh, not a reset to default paths.
        for key, value in previous["settings"].items():
            env.setdefault(key, value)
        env.setdefault("PI_SETUP_CODE_ROOT", previous["code_root"])
        env.setdefault("PI_SHARED_AGENT_DIR", previous["agent_dir"])
        env.setdefault("PI_SHARED_CLI_OUT", previous["cli_file"])
    if remote and env.get("PI_SHARED_BOOTSTRAP_LAUNCHERS") == "0":
        raise RuntimeError("Existing gateway setup requires CLI bootstrap; remove PI_SHARED_BOOTSTRAP_LAUNCHERS=0.")
    code_root = Path(env.get("PI_SETUP_CODE_ROOT", str(Path.home() / ".local/share/pi-shared/modules"))).expanduser().resolve()
    flags = ["--minimal"]
    modules = ["pi-shared"]
    if args.mode not in {"later", "existing-gateway"}:
        modules.append("model-gateway")
    if not args.without_browser:
        modules.append("browser-worker")
    if args.with_search:
        modules.append("local_web_search")
    flags += [f"--with-{m}" for m in modules[1:]]
    if args.update:
        flags.append("--update")
    if args.with_omnigent:
        agent_dir = Path(env.get("PI_SHARED_AGENT_DIR", str(Path.home() / ".pi/agent"))).expanduser().resolve()
        if agent_dir != (Path.home() / ".pi/agent").resolve():
            raise RuntimeError("Omnigent compatibility currently requires the standard ~/.pi/agent profile; no configuration was changed.")
        flags.append("--with-omnigent")
    print("Setup plan (Homebrew installation alone does not run this):")
    print(f"  Modules: {', '.join(modules)}\n  Writable module root: {code_root}")
    print("  Install locked module dependencies, wire Pi profiles and CLI routing, start selected services, run doctor.")
    print("  Remove only recognized legacy shell wiring with a private backup; no new shell startup hooks.")
    print("  Existing selected services may restart. Unselected modules/services are not removed or stopped.")
    if "browser-worker" in modules:
        print("  Browser selection downloads Chromium. No LLM weights are downloaded.")
    else:
        print("  No browser or LLM weights are downloaded.")
    print("  Command: " + shlex.join([str(ROOT / "install.sh"), *flags]))
    print(f"  oMLX: {args.omlx or 'not selected'}; recovery: {args.recovery}")
    if gateway:
        print(f"  Direct external gateway: {gateway['url']}")
        print(f"  Existing key file reference: {gateway['key_file']} (owner-only 0600; contents never copied into the receipt)")
        print(f"  Private HTTP explicitly allowed: {gateway['allow_private_http']}")
        print("  Authenticated catalog read: GET /v1/models/canonical; no inference requests.")
        print("  No local gateway or oMLX service installed; no remote service operations or credential provisioning.")
    if args.with_search:
        print("  Search requires a pre-provisioned owner-only Brave API key; see the search module README.")
    if args.plan:
        guidance(args, code_root)
        return 0
    if platform.system() != "Darwin":
        raise RuntimeError("Service setup currently supports macOS only.")
    for command in ("pi", "node", "npm", "git", "uv", "python3"):
        if not shutil.which(command):
            raise RuntimeError(f"Missing {command}; install the Homebrew pi-shared package or see README prerequisites.")
    if args.omlx == "install":
        if not shutil.which("brew"):
            raise RuntimeError("Homebrew is required to install oMLX.")
        hardware()
        guard_fresh_omlx()
    if not args.yes:
        if not interactive:
            raise RuntimeError("Setup needs a terminal or --yes. Use --plan to inspect without changes.")
        if input("Apply this plan? [y/N] ").strip().lower() not in {"y", "yes"}:
            print("Cancelled; no installation changes made.")
            return 0
    if gateway:
        existing_gateway.check_key_file(gateway)
    with update_lock():
        current = read_state(allow_incomplete=True) if state_path().exists() else None
        if current != previous:
            raise RuntimeError("Setup receipt changed during approval; rerun to review the current selection.")
        return apply_setup(args, code_root, modules, flags, env, gateway)


def apply_setup(args, code_root, modules, flags, env, gateway=None):
    agent_dir = str(Path(env.get("PI_SHARED_AGENT_DIR", str(Path.home() / ".pi/agent"))).expanduser().resolve())
    state = {"version": 2, "status": "incomplete", "code_root": str(code_root),
             "modules": modules, "agent_dir": agent_dir,
             "mode": args.mode, "omlx": args.omlx, "omlx_url": args.omlx_url,
             "omnigent": args.with_omnigent}
    if gateway:
        state["external_gateway"] = gateway
    env = {**env, "PI_SETUP_CODE_ROOT": str(code_root), "PI_SHARED_AGENT_DIR": agent_dir}
    env.setdefault("PI_SHARED_BOOTSTRAP_LAUNCHERS", "1")
    env.setdefault("PI_SHARED_CLI_OUT", str(Path.home() / ".pi/launcher.json"))
    # Fresh public setups include direct helpers. Preserve existing generated
    # selections and explicit canonical/legacy opt-outs on every rerun.
    launchers = Path(env.get("PI_SHARED_LAUNCHERS_OUT", str(Path.home() / ".pi/generated/pi-launchers.zsh"))).expanduser()
    legacy = Path.home() / ".pi/model-gateway/pi-launchers.zsh"
    preference = env.get("PI_SHARED_DIRECT_LAUNCHERS", env.get("PI_SHARED_LS99_EXTRAS", ""))
    if not preference and not any(p.exists() or p.is_symlink() for p in (launchers, legacy, Path(env["PI_SHARED_CLI_OUT"]).expanduser())):
        env["PI_SHARED_DIRECT_LAUNCHERS"] = "1"
    state["bootstrap_launchers"] = env["PI_SHARED_BOOTSTRAP_LAUNCHERS"] == "1"
    state["settings"] = update_support.remember_settings(env)
    env.update(state["settings"])
    state["cli_file"] = env["PI_SHARED_CLI_OUT"]
    if gateway:
        env["PI_LAUNCHER_CONFIG"] = state["cli_file"]
    state["launchers_file"] = str(launchers.resolve())  # legacy migration input, never evaluated
    state["recovery"] = args.recovery
    state["operation"] = "setup"
    write_state(state)
    run([ROOT / "install.sh", *flags], env=env)
    if gateway:
        run(existing_gateway.command(state, "connect"), env=env)
        print("External gateway catalog configured. Remote readiness and inference NOT verified. Use pi models to list aliases.")
    if args.omlx == "install":
        run(["brew", "tap", "jundot/omlx", "https://github.com/jundot/omlx"])
        run(["brew", "install", OMLX_FORMULA])
        run(["brew", "services", "start", OMLX_FORMULA])
        print("Waiting up to 60 seconds for oMLX model discovery (not inference)...", flush=True)
        wait_omlx("http://127.0.0.1:8000/v1")
        print("oMLX model listing responds; model readiness not tested. Manage models at http://127.0.0.1:8000/admin.")
    elif args.omlx == "existing":
        discover_models(args.omlx_url)
    if args.omlx == "install":
        state["omlx_version"] = update_support.omlx_version()
    state["launcher_refresh"] = state["bootstrap_launchers"] or Path(state["cli_file"]).is_file() or launchers.is_file()
    state["runtime_versions"] = update_support.runtime_versions()
    state["revisions"] = update_support.revisions(code_root, modules)
    state["services"] = update_support.service_snapshot(modules, state["settings"], args.omlx)
    state["status"] = "module-checks-passed"
    write_state(state)
    print("Selected module checks passed. Authentication, local routing, inference and recovery readiness are separate.")
    guidance(args, code_root)
    return 0


def safe_path(value):
    return isinstance(value, str) and bool(value) and not any(c in value for c in "\r\n\0") and Path(value).is_absolute()


def read_state(allow_incomplete=False):
    path = state_path()
    if not path.is_file() or path.is_symlink():
        raise RuntimeError("No safe setup receipt found. Run pi-shared setup; source-only users can use bin/doctor.")
    info = path.stat()
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077 or info.st_nlink != 1 or info.st_size > 65536:
        raise RuntimeError("Setup receipt must be owned by you with mode 0600.")
    for directory in (path.parent, path.parent.parent):
        info = directory.lstat()
        if stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise RuntimeError("Unsafe setup receipt directory")
    data = json.loads(path.read_text())
    if (not isinstance(data, dict) or data.get("version") not in (1, 2)
            or not isinstance(data.get("modules"), list) or not data["modules"]
            or any(not isinstance(m, str) or m not in MODULES for m in data["modules"])
            or not safe_path(data.get("code_root")) or not safe_path(data.get("agent_dir"))
            or ("bootstrap_launchers" in data and not isinstance(data["bootstrap_launchers"], bool))
            or ("omnigent" in data and not isinstance(data["omnigent"], bool))
            or data.get("status") not in {"incomplete", "module-checks-passed"}):
        raise RuntimeError("Invalid setup receipt; rerun setup after reviewing configuration.")
    if data.get("omnigent", False) and Path(data["agent_dir"]).resolve() != (Path.home() / ".pi/agent").resolve():
        raise RuntimeError("Omnigent compatibility currently requires the standard ~/.pi/agent profile")
    if data.get("version") == 2:
        settings = data.get("settings")
        if (not isinstance(settings, dict) or any(k not in update_support.SETTINGS or not isinstance(v, str) for k, v in settings.items())
                or not any(key in data for key in ("cli_file", "launchers_file"))
                or any(not safe_path(data[key]) for key in ("cli_file", "launchers_file") if key in data)
                or not isinstance(data.get("revisions", {}), dict) or not isinstance(data.get("services", {}), dict)):
            raise RuntimeError("Invalid remembered update settings")
        if update_support.remember_settings(settings) != settings:
            raise RuntimeError("Remembered paths must be absolute and normalized")
        if "omlx_version" in data and (not isinstance(data["omlx_version"], str) or not data["omlx_version"] or len(data["omlx_version"]) > 128):
            raise RuntimeError("Invalid applied oMLX version")
        for name, service in data.get("services", {}).items():
            if (name not in (*data["modules"], "omlx") or not isinstance(service, dict)
                    or set(service) != {"path", "identity"} or not isinstance(service["path"], str)
                    or not Path(service["path"]).is_absolute() or not isinstance(service["identity"], str)
                    or not re.fullmatch(r"[0-9a-f]{64}", service["identity"])):
                raise RuntimeError("Invalid saved service ownership")
        if ("pi-shared" not in data["modules"] or len(set(data["modules"])) != len(data["modules"])
                or data.get("omlx") not in (None, "existing", "guide", "install")
                or any(not isinstance(k, str) or k not in data["modules"] or not isinstance(v, str)
                       or len(v) != 40 or any(c not in "0123456789abcdef" for c in v)
                       for k, v in data.get("revisions", {}).items())):
            raise RuntimeError("Invalid update selection/revisions")
    if "external_gateway" in data:
        existing_gateway.validate_saved(data["external_gateway"])
        if (data["version"] != 2 or data.get("mode") != "existing-gateway" or "cli_file" not in data
                or "model-gateway" in data["modules"] or data.get("omlx") or data.get("omlx_url")
                or "omlx" in data.get("services", {})
                or data["settings"].get("PI_SHARED_CLI_OUT", data["cli_file"]) != data["cli_file"]):
            raise RuntimeError("Invalid external gateway selection; local gateway/oMLX cannot be mixed with it")
    elif data.get("mode") == "existing-gateway":
        raise RuntimeError("Missing saved external gateway connection; rerun setup with explicit connection options")
    if data["status"] == "incomplete" and not allow_incomplete:
        raise RuntimeError("Previous setup did not complete; rerun its plan to repair. Completed installs were not rolled back.")
    return data


def status(require_omnigent=False):
    data = read_state()
    print("Checking last selected modules only; provider/model/recovery readiness is not implied.", flush=True)
    env = {k: v for k, v in os.environ.items() if not k.startswith(("PI_SHARED_", "PI_SETUP_", "PI_LAUNCHER_"))}
    env.update(data.get("settings", {}))
    env.update(PI_SETUP_CODE_ROOT=data["code_root"], PI_CODING_AGENT_DIR=data["agent_dir"],
               PI_SHARED_BOOTSTRAP_LAUNCHERS="1" if data.get("bootstrap_launchers") is True else "0")
    if "cli_file" in data:
        env.update(PI_SHARED_CLI_OUT=data["cli_file"], PI_LAUNCHER_CONFIG=data["cli_file"])
    elif "launchers_file" in data:
        env["PI_SHARED_LAUNCHERS_OUT"] = data["launchers_file"]
    command = [ROOT / "bin/doctor", *[arg for m in data["modules"] for arg in ("--module", m)]]
    if require_omnigent or data.get("omnigent", False):
        command.append("--require-omnigent")
    run(command, env=env)
    if data.get("external_gateway"):
        run(existing_gateway.command(data, "check"), env=env)
        print("External gateway configuration checked OFFLINE; remote reachability, authentication and inference NOT tested.")
    if data.get("omlx"):
        print("oMLX is separately managed; status does not test its service or model inference.")
    return 0


@contextmanager
def update_lock():
    parent = state_path().parent
    for directory in (Path.home() / ".config", parent):
        if directory.is_symlink():
            raise RuntimeError("Unsafe symlinked update lock directory")
        directory.mkdir(mode=0o700, exist_ok=True)
        if directory.stat().st_uid != os.getuid() or directory.stat().st_mode & 0o022:
            raise RuntimeError("Unsafe update lock directory")
    path = parent / "update.lock"
    inherited = os.environ.pop("PI_SHARED_UPDATE_LOCK_FD", None)
    if inherited and (not inherited.isdecimal() or len(inherited) > 9):
        raise RuntimeError("Invalid inherited update lock descriptor")
    fd = int(inherited) if inherited else os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        target = path.lstat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1
                or info.st_mode & 0o077 or (info.st_dev, info.st_ino) != (target.st_dev, target.st_ino)):
            raise RuntimeError("Unsafe update lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("Another setup/update is running; try again after it finishes") from None
        yield fd
    finally:
        os.close(fd)


def update(args):
    data = read_state(allow_incomplete=True)
    if data["version"] != 2:
        raise RuntimeError("This older receipt did not record all choices. Run setup once with this version; future updates need no questionnaire.")
    if data["status"] == "incomplete" and data.get("operation") != "update":
        raise RuntimeError("Initial setup is incomplete; finish setup before updating")
    print("Update plan: retain saved modules, paths, models and preferences.")
    print("  Selected: " + ", ".join(data["modules"]))
    if data.get("external_gateway"):
        print(f"  Preserve external gateway: {data['external_gateway']['url']}; check configuration OFFLINE only.")
        print("  No remote catalog refresh or remote service operations. Rerun setup to explicitly refresh discovery.")
    if data.get("omlx") == "install":
        print("  Also update owned Homebrew oMLX; restart it only if its installed version changes.")
    print("  Update owned CLI/runtime; apply changed selected services; refresh dependencies/shortcuts; verify.")
    print("  No LLM model downloads or provider calls. Affected services may restart; failed steps are not rolled back.")
    if args.plan:
        return 0
    if platform.system() != "Darwin":
        raise RuntimeError("Updates currently support macOS only")
    with update_lock() as fd:
        # Re-read after locking. Always use saved selection, not calling-shell overrides.
        data = read_state(allow_incomplete=True)
        if data["version"] != 2 or (data["status"] == "incomplete" and data.get("operation") != "update"):
            raise RuntimeError("Setup receipt changed; finish setup before updating")
        service_env = update_support.service_environment(data)
        omlx_url = update_support.omlx_url() if data.get("omlx") == "install" else None
        retry_modules = data["status"] == "incomplete" and data.get("phase") == "modules"
        data.update(status="incomplete", operation="update")
        write_state(data)
        if not args.modules_only:
            # Keep a failed application retry distinct from the normal re-exec.
            if not retry_modules:
                data["phase"] = "package"
                write_state(data)
            marker = ROOT / "homebrew.json"
            if marker.exists():
                ownership = json.loads(marker.read_text())
                formula = ownership.get("formula") if isinstance(ownership, dict) else None
                if (not isinstance(formula, str) or not re.fullmatch(r"[a-z0-9_-]+/[a-z0-9_-]+/pi-shared", formula)
                        or ownership != {"manager": "homebrew", "formula": formula}):
                    raise RuntimeError("Invalid Homebrew ownership marker")
                prefix = Path(subprocess.check_output(["brew", "--prefix", formula], text=True).strip())
                if prefix.resolve() != ROOT.parent.resolve():
                    raise RuntimeError("This CLI is not the installed Homebrew package; refusing to update a different installation")
                launcher = prefix / "bin/pi-shared"
                run(["brew", "update"])
                # This checks existing HEAD installs without switching stable channels.
                run(["brew", "upgrade", "--fetch-HEAD", formula])
            else:
                top = subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "--show-toplevel"], text=True).strip()
                dirty = subprocess.check_output(["git", "-C", str(ROOT), "status", "--porcelain", "--untracked-files=all"], text=True)
                if Path(top).resolve() != ROOT.resolve() or dirty:
                    raise RuntimeError("Source orchestrator must be a clean repository root")
                run(["git", "-C", ROOT, "symbolic-ref", "-q", "HEAD"])
                run(["git", "-C", ROOT, "rev-parse", "--verify", "@{upstream}"])
                run(["git", "-C", ROOT, "pull", "--ff-only"])
                launcher = ROOT / "bin/pi-shared"
            os.set_inheritable(fd, True)
            env = {**os.environ, "PI_SHARED_UPDATE_LOCK_FD": str(fd)}
            os.execve(launcher, [str(launcher), "update", "--modules-only"], env)
            return 0
        env = {k: v for k, v in os.environ.items() if not k.startswith(("PI_SHARED_", "PI_SETUP_", "PI_LAUNCHER_", "MODEL_GATEWAY_", "GATEWAY_VISION_", "LOCAL_SEARCH_", "BROWSER_WORKER_", "WEBSEARCH_", "DECODO_", "MCP_PORT"))}
        env.update(data["settings"])
        env.update(service_env)
        env.update(PI_SETUP_CODE_ROOT=data["code_root"], PI_SHARED_AGENT_DIR=data["agent_dir"],
                   PI_SHARED_BOOTSTRAP_LAUNCHERS="1" if data.get("bootstrap_launchers") else "0",
                   PI_SHARED_CLI_OUT=data.get("cli_file", str(Path.home() / ".pi/launcher.json")),
                   PI_SETUP_REFRESH_LAUNCHERS="1" if data.get("launcher_refresh", True) else "0",
                   PI_SETUP_INSTALLED_REVISIONS=json.dumps(data.get("revisions", {})
                       if not retry_modules and data.get("runtime_versions") == update_support.runtime_versions() else {}))
        if "launchers_file" in data:
            env["PI_SHARED_LAUNCHERS_OUT"] = data["launchers_file"]
        env["PI_LAUNCHER_CONFIG"] = env["PI_SHARED_CLI_OUT"]
        data["cli_file"] = env["PI_SHARED_CLI_OUT"]
        data["settings"]["PI_SHARED_CLI_OUT"] = data["cli_file"]
        data.update(status="incomplete", operation="update", phase="modules")
        write_state(data)
        if data.get("omlx") == "install":
            update_support.omlx_version()  # refuse a missing installation before upgrade
            run(["brew", "upgrade", "--fetch-HEAD", OMLX_FORMULA])
            after = update_support.omlx_version()
            if data.get("omlx_version") != after:
                # Compare to the last successfully applied version, not this
                # invocation's pre-upgrade package: a failed restart must retry.
                run(["brew", "services", "restart", OMLX_FORMULA])
            wait_omlx(omlx_url, allow_auth_required=True)
            owned = update_support.service_snapshot([], data["settings"], "install").get("omlx")
            if not owned:
                raise RuntimeError("oMLX ownership metadata is missing after update")
            data["omlx_version"] = after
            data["services"]["omlx"] = owned
            write_state(data)
        command = [ROOT / "install.sh", "--update-changed", "--only", ",".join(data["modules"])]
        if data.get("omnigent", False):
            command.append("--with-omnigent")
        run(command, env=env)
        if data.get("external_gateway"):
            run(existing_gateway.command(data, "check"), env=env)
        data["runtime_versions"] = update_support.runtime_versions()
        data["revisions"] = update_support.revisions(Path(data["code_root"]), data["modules"])
        data["services"] = update_support.service_snapshot(data["modules"], data["settings"], data.get("omlx"))
        data["status"] = "module-checks-passed"
        data["phase"] = "verified"
        write_state(data)
    print("Update verified. Use pi models. Restart older shells to discard previously loaded launcher functions.")
    return 0


def main():
    parser = argparse.ArgumentParser(description="pi-shared — install and configure a Pi environment via pi-setup.")
    parser.add_argument("--version", action="version", version="pi-shared setup 0.1.7")
    commands = parser.add_subparsers(dest="command", required=True)
    p = commands.add_parser("setup", help="Explicitly install/configure modules and start their services")
    p.add_argument("--mode", choices=["cloud", "local", "both", "later", "existing-gateway"])
    p.add_argument("--gateway-url", help="Existing remote gateway base URL (HTTPS preferred; optional /v1)")
    p.add_argument("--gateway-key-file", help="Absolute path to an existing owner-only 0600 key file; never a literal key")
    p.add_argument("--allow-private-http", action="store_true", default=None,
                   help="Explicitly trust private/Tailscale HTTP for existing-gateway; the key is sent without TLS")
    p.add_argument("--local", action="store_true", help="Shortcut for --mode local; oMLX remains opt-in")
    p.add_argument("--omlx", choices=["existing", "install", "guide"], help="Default: prompt, or guide in non-interactive mode")
    p.add_argument("--omlx-url", type=loopback_url, help="Explicit numeric loopback OpenAI URL for existing oMLX")
    p.add_argument("--recovery", choices=["skip", "guide"], help="Independent pi-fallback prototype; no automatic installation")
    p.add_argument("--without-browser", action="store_true", help="Do not select browser-worker/Chromium")
    p.add_argument("--with-search", action="store_true", help="Select search (pre-provision Brave key per module README first)")
    p.add_argument("--with-omnigent", action="store_true", help="Require native-Pi prerequisites; no Omnigent install, session launch, or inference")
    p.add_argument("--update", action="store_true", help="Explicitly fetch/update selected writable module checkouts")
    p.add_argument("--yes", action="store_true", help="Apply explicit choices without prompting; never download LLM weights")
    p.add_argument("--plan", action="store_true", help="Show plan without commands, downloads, network or file changes")
    u = commands.add_parser("update", help="Update the saved installation; no repeated setup questionnaire")
    u.add_argument("--plan", action="store_true", help="Read-only saved update plan")
    u.add_argument("--modules-only", action="store_true", help="Update selected modules without upgrading the owning CLI/runtime")
    s = commands.add_parser("status", help="Run doctor for the last successfully selected modules (executes trusted extension checks)")
    s.add_argument("--require-omnigent", action="store_true", help="Also check native-Pi prerequisites without changing the saved selection")
    args = parser.parse_args()
    try:
        if args.command == "setup":
            return setup(args)
        return update(args) if args.command == "update" else status(args.require_omnigent)
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled; completed actions, if any, were not rolled back.", file=sys.stderr)
        return 130
    except (RuntimeError, OSError, ValueError, argparse.ArgumentTypeError) as exc:
        print(f"pi-shared: {exc}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        print(f"pi-shared: command failed ({exc.returncode}); setup incomplete. Completed actions were not rolled back.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
