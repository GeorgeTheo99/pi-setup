#!/usr/bin/env bash
# pi-setup doctor — health checks for the composed Pi environment.
# Exits 0 if all installed components are healthy; non-zero otherwise.
set -uo pipefail

CODE_ROOT="${PI_SETUP_CODE_ROOT:-$HOME/local_code}"
FAIL=0

ok()   { printf '  \033[1;32mOK\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[1;31mFAIL\033[0m  %s\n' "$*"; FAIL=1; }
skip() { printf '  \033[1;33mskip\033[0m  %s\n' "$*"; }

echo "pi-setup doctor"

# --- pi CLI -----------------------------------------------------------------
if command -v pi >/dev/null; then
  ok "pi CLI on PATH ($(pi --version 2>/dev/null | head -1 || echo version unknown))"
else
  bad "pi CLI not on PATH — install Pi first (see README prerequisites)"
fi

# --- pi-shared --------------------------------------------------------------
if [ -d "$CODE_ROOT/pi-shared" ]; then
  ok "pi-shared cloned"
  SETTINGS="$HOME/.pi/agent/settings.json"
  if [ -f "$SETTINGS" ] && grep -q "pi-shared" "$SETTINGS" 2>/dev/null; then
    ok "pi-shared registered in ~/.pi/agent/settings.json"
  else
    bad "pi-shared not registered as a Pi package in $SETTINGS"
  fi
else
  bad "pi-shared missing under $CODE_ROOT"
fi

# --- model-gateway ----------------------------------------------------------
if [ -d "$CODE_ROOT/model-gateway" ]; then
  if curl -sf -m 3 http://127.0.0.1:9111/health >/dev/null 2>&1; then
    ok "model-gateway healthy on :9111"
  else
    bad "model-gateway cloned but not responding on :9111 (run: model-gateway status)"
  fi
else
  skip "model-gateway not installed (optional with --minimal)"
fi

# --- local_web_search --------------------------------------------------------
if [ -d "$CODE_ROOT/local_web_search" ]; then
  if curl -sf -m 3 -o /dev/null http://127.0.0.1:8889/mcp 2>/dev/null || \
     curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8889/mcp 2>/dev/null | grep -qE '^(200|405|406)'; then
    ok "local_web_search broker responding on :8889"
  else
    bad "local_web_search cloned but broker not responding on :8889"
  fi
else
  skip "local_web_search not installed (enable with --with-local_web_search)"
fi

# --- overlays ----------------------------------------------------------------
for overlay_doctor in "$CODE_ROOT"/pi-setup-*/bin/doctor; do
  [ -x "$overlay_doctor" ] || continue
  echo "overlay: $(basename "$(dirname "$(dirname "$overlay_doctor")")")"
  "$overlay_doctor" || FAIL=1
done

exit "$FAIL"
