#!/usr/bin/env bash
# pi-setup doctor — health checks for the composed Pi environment.
# Exits 0 if all installed components are healthy; non-zero otherwise.
#
# Read-only and free of billable model calls by default. Every FAIL line
# names its repair. Options:
#   --smoke-model <alias>   additionally run one real no-tools completion
#                           through the generated `pi-<alias>` launcher
set -uo pipefail

CODE_ROOT="${PI_SETUP_CODE_ROOT:-$HOME/local_code}"
FAIL=0
SMOKE_MODEL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --smoke-model) shift; SMOKE_MODEL="${1:?--smoke-model requires an alias}" ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
  shift
done

ok()   { printf '  \033[1;32mOK\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[1;31mFAIL\033[0m  %s\n' "$*"; FAIL=1; }
skip() { printf '  \033[1;33mskip\033[0m  %s\n' "$*"; }

echo "pi-setup doctor"

# --- pi CLI -----------------------------------------------------------------
if command -v pi >/dev/null; then
  ok "pi CLI on PATH ($(pi --version 2>/dev/null | head -1 || echo version unknown))"
else
  bad "pi CLI not on PATH — install Pi first (see README prerequisites)"
fi

# --- pi-shared --------------------------------------------------------------
if [ -d "$CODE_ROOT/pi-shared" ]; then
  ok "pi-shared cloned"
  SETTINGS="$HOME/.pi/agent/settings.json"
  if [ -f "$SETTINGS" ] && grep -q "pi-shared" "$SETTINGS" 2>/dev/null; then
    ok "pi-shared registered in ~/.pi/agent/settings.json"
  else
    bad "pi-shared not registered as a Pi package in $SETTINGS (run: $CODE_ROOT/pi-shared/install.sh)"
  fi
  CHECK="$CODE_ROOT/pi-shared/bin/pi-shared-check-deps"
  if [ -x "$CHECK" ]; then
    if out="$("$CHECK" 2>&1)"; then
      ok "pi-shared extension dependencies resolve (yaml, patchright, playwright)"
    else
      bad "pi-shared extension dependencies missing — Pi will fail to start (run: $CODE_ROOT/pi-shared/install.sh):"
      printf '%s\n' "$out" | grep FAIL | sed 's/^/        /'
    fi
  else
    bad "pi-shared is outdated (no bin/pi-shared-check-deps); run: git -C $CODE_ROOT/pi-shared pull && $CODE_ROOT/pi-shared/install.sh"
  fi
else
  bad "pi-shared missing under $CODE_ROOT"
fi

# --- Pi extension load probe ------------------------------------------------
# Pi imports every registered extension at startup; a dependency or duplicate
# tool problem surfaces as a diagnostic even when the command exits 0.
if command -v pi >/dev/null; then
  probe="$(cd "$HOME" && timeout 60 pi --list-models 2>&1 </dev/null || true)"
  if printf '%s' "$probe" | grep -qiE "Failed to load extension|Cannot find module|already registered|duplicate tool"; then
    bad "Pi reports extension load errors:"
    printf '%s\n' "$probe" | grep -iE "Failed to load extension|Cannot find module|already registered|duplicate tool" | head -5 | sed 's/^/        /'
  else
    ok "Pi loads all registered extensions without errors"
  fi
fi

# --- model-gateway ----------------------------------------------------------
if [ -d "$CODE_ROOT/model-gateway" ]; then
  if curl -sf -m 3 http://127.0.0.1:9111/health >/dev/null 2>&1; then
    ok "model-gateway healthy on :9111"
  else
    bad "model-gateway cloned but not responding on :9111 (run: model-gateway status)"
  fi
else
  skip "model-gateway not installed (optional with --minimal)"
fi

# --- local_web_search --------------------------------------------------------
if [ -d "$CODE_ROOT/local_web_search" ]; then
  if curl -sf -m 3 -o /dev/null http://127.0.0.1:8889/mcp 2>/dev/null || \
     curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8889/mcp 2>/dev/null | grep -qE '^(200|405|406)'; then
    ok "local_web_search broker responding on :8889"
  else
    bad "local_web_search cloned but broker not responding on :8889"
  fi
else
  skip "local_web_search not installed (enable with --with-local_web_search)"
fi

# --- generated launchers ----------------------------------------------------
LAUNCHERS="$HOME/.pi/generated/pi-launchers.zsh"
if [ -d "$CODE_ROOT/model-gateway" ]; then
  if [ -s "$LAUNCHERS" ]; then
    if zsh -n "$LAUNCHERS" 2>/dev/null; then
      ok "generated launchers parse ($LAUNCHERS)"
    else
      bad "generated launchers have a syntax error: $LAUNCHERS (regenerate: pi-regen)"
    fi
    if zsh -ic 'whence -w pi-list' 2>/dev/null | grep -q function; then
      ok "pi-list resolves in a new zsh session"
    else
      bad "pi-list not found in a new zsh — ~/.zshrc must source $LAUNCHERS (re-run install.sh, or add: [ -f \"$LAUNCHERS\" ] && source \"$LAUNCHERS\")"
    fi
  else
    bad "no generated launchers at $LAUNCHERS — model catalog not activated (see overlay doctor below)"
  fi
fi

# --- overlays ----------------------------------------------------------------
# An overlay is any repo under CODE_ROOT with a manifest.fragment.yaml; run
# its bin/doctor if present.
for fragment in "$CODE_ROOT"/*/manifest.fragment.yaml; do
  [ -f "$fragment" ] || continue
  overlay_dir="$(dirname "$fragment")"
  overlay_doctor="$overlay_dir/bin/doctor"
  [ -x "$overlay_doctor" ] || continue
  echo "overlay: $(basename "$overlay_dir")"
  "$overlay_doctor" || FAIL=1
done

# --- optional real completion -------------------------------------------------
if [ -n "$SMOKE_MODEL" ]; then
  if zsh -ic "pi-$SMOKE_MODEL --no-tools -p 'Reply with exactly PI_OK' 2>/dev/null" </dev/null | grep -q PI_OK; then
    ok "pi-$SMOKE_MODEL answered a real no-tools completion"
  else
    bad "pi-$SMOKE_MODEL did not answer (run it interactively to see the error)"
  fi
fi

exit "$FAIL"
