#!/usr/bin/env python3
"""Check installation readiness without shell startup, repair, or model calls.

Extension registration code executes through Pi's SDK (just as at startup).
Optional --smoke-model ALIAS explicitly opts into one billable completion.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import subprocess
import sys
import urllib.error
import urllib.request


class Doctor:
    def __init__(self):
        self.failed = False

    def ok(self, message):
        print(f"  OK    {message}")

    def bad(self, message):
        self.failed = True
        print(f"  FAIL  {message}")

    def warn(self, message):
        print(f"  WARN  {message}")

    def command(self, argv, *, timeout=90, optional=False, required_line=None):
        try:
            process = subprocess.Popen(argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       start_new_session=True)
            try:
                out, err = process.communicate(timeout=timeout)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.communicate()
                raise
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.bad(f"Cannot complete {shlex.join(map(str, argv))}: {exc}")
            return False
        text = (out + err).strip()
        if optional and process.returncode == 2:
            self.warn(text or f"Optional capability unavailable: {argv[0]}")
            return False
        if process.returncode != 0:
            self.bad(f"Check exited {process.returncode}: {shlex.join(map(str, argv))}")
            if text:
                print(text[-6000:])
            return False
        if required_line is not None and required_line not in [line.strip() for line in out.splitlines()]:
            self.bad(f"Command completed but did not return the expected response {required_line!r}")
            return False
        if text:
            print(text[-6000:])
        return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--smoke-model", metavar="ALIAS")
    args = parser.parse_args()
    home = Path.home()
    root = Path(os.environ.get("PI_SETUP_CODE_ROOT", home / "local_code")).resolve()
    shared = root / "pi-shared"
    doctor = Doctor()
    print("pi-setup doctor")
    if not shutil.which("pi"):
        doctor.bad("Pi CLI is not on PATH. Install Pi first; see pi-setup README prerequisites.")
    else:
        doctor.command(["pi", "--version"], timeout=15)
    checker = shared / "bin/pi-shared-check-deps"
    probe = shared / "bin/pi-profile-check"
    if not checker.is_file() or not probe.is_file():
        doctor.bad(f"Missing pi-shared health helpers. Repair: {shared / 'install.sh'}")
    else:
        doctor.command([str(checker)])
        doctor.command([str(probe), "--agent-dir", str(home / ".pi/agent"), "--expect-package", str(shared)])

    gateway = root / "model-gateway"
    launchers = home / ".pi/generated/pi-launchers.zsh"
    if gateway.is_dir():
        try:
            with urllib.request.urlopen("http://127.0.0.1:9111/health", timeout=3) as response:
                health = json.loads(response.read(65536))
            if health.get("status") != "ok" or health.get("service") != "model-gateway":
                raise ValueError("response is not a healthy model-gateway")
            doctor.ok("model-gateway /health identifies the expected service")
        except (OSError, ValueError) as exc:
            doctor.bad(f"model-gateway health failed: {exc}. Repair: {gateway / 'bin/model-gateway'} restart")
        if not launchers.is_file():
            doctor.bad(f"Missing launchers: {launchers}. Repair: rerun the overlay catalog hook.")
        elif not shutil.which("zsh"):
            doctor.bad("zsh is required for the generated model launchers")
        else:
            doctor.command(["zsh", "-n", str(launchers)], timeout=10)
            if os.environ.get("PI_SETUP_NO_SHELL_RC") == "1":
                doctor.warn(f"Shell integration opted out; source {launchers} before using model launchers")
            else:
                rc = Path(os.environ.get("PI_SETUP_ZSHRC", home / ".zshrc"))
                lines = rc.read_text().splitlines() if rc.is_file() else []
                if not any(not line.lstrip().startswith("#") and "pi-launchers.zsh" in line for line in lines):
                    doctor.bad(f"No launcher hook in {rc}. Repair: rerun pi-setup/install.sh")
                else:
                    doctor.ok("Launcher syntax and shell hook configured (shell startup not executed)")
        if probe.is_file():
            argv = [str(probe), "--agent-dir", str(home / ".pi-omlx/agent"),
                    "--expect-package", str(shared), "--require-models"]
            overlay = root / "pi-databricks"
            if overlay.is_dir():
                argv += ["--expect-package", str(overlay)]
            doctor.command(argv)
    else:
        doctor.warn("model-gateway not installed; generated model launchers are not configured")

    browser = shared / "bin/pi-browser-check"
    if browser.is_file():
        doctor.command([sys.executable, str(browser)], timeout=10, optional=True)
    else:
        doctor.warn("Browser readiness helper missing; public browser capability has not been verified")

    for manifest in sorted(root.glob("*/manifest.fragment.yaml")):
        check = manifest.parent / "bin/doctor"
        if check.is_file():
            print(f"overlay: {manifest.parent.name}")
            doctor.command([str(check)], timeout=120)

    if args.smoke_model:
        if not re.fullmatch(r"[a-zA-Z0-9_-]+", args.smoke_model):
            doctor.bad("--smoke-model must be a launcher alias (letters, numbers, _ or -)")
        elif not launchers.is_file():
            doctor.bad("Cannot smoke a model before launchers are installed")
        else:
            doctor.command(["zsh", "-f", "-c", 'source "$1"; "$2" --no-tools -p "Reply with exactly PI_OK"',
                            "doctor", str(launchers), f"pi-{args.smoke_model}"], timeout=180, required_line="PI_OK")
    return int(doctor.failed)


if __name__ == "__main__":
    sys.exit(main())
