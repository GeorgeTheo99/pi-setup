#!/usr/bin/env bash
# pi-setup doctor — read-only evidence for the composed Pi environment.
# Usage: bin/doctor [--module NAME ...] [--overlay DIRECTORY ...]
# Without --module, check known modules present under CODE_ROOT. Overlay code
# is only executed when explicitly named. No provider requests or repairs.
set -uo pipefail

CODE_ROOT="${PI_SETUP_CODE_ROOT:-$HOME/local_code}"
AGENT_DIR="${PI_CODING_AGENT_DIR:-${PI_SHARED_AGENT_DIR:-$HOME/.pi/agent}}"
FAIL=0
declare -a MODULES=()
declare -a OVERLAYS=()

ok()   { printf '  \033[1;32mOK\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[1;31mFAIL\033[0m  %s\n' "$*"; FAIL=1; }
skip() { printf '  \033[1;33mskip\033[0m  %s\n' "$*"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --module|--overlay)
      flag="$1"; shift
      [ $# -gt 0 ] && [ -n "$1" ] || { bad "$flag requires a value"; exit 2; }
      if [ "$flag" = --module ]; then MODULES+=("$1"); else OVERLAYS+=("$1"); fi
      ;;
    -h|--help) printf 'Usage: bin/doctor [--module NAME ...] [--overlay DIRECTORY ...]\n'; exit 0 ;;
    *) bad "Unknown flag: $1"; exit 2 ;;
  esac
  shift
done

selected() {
  [ "${#MODULES[@]}" -gt 0 ] || return 0
  local name
  for name in "${MODULES[@]}"; do [ "$name" = "$1" ] && return 0; done
  return 1
}

check_service() {
  local name="$1" checker="$2" evidence="$3"
  if ! selected "$name"; then
    skip "$name not selected"
  elif [ ! -d "$CODE_ROOT/$name" ]; then
    if [ "${#MODULES[@]}" -gt 0 ]; then bad "$name selected but missing"; else skip "$name not installed"; fi
  else
    ok "$name source present (not proof of installation or readiness)"
    if [ ! -x "$checker" ]; then
      bad "$name read-only verifier missing: $checker"
    elif "$checker" verify; then
      ok "$name: $evidence"
    else
      bad "$name verification failed; run: $checker verify"
    fi
  fi
}

echo "pi-setup doctor (read-only; no provider calls)"

if command -v pi >/dev/null; then
  if version="$(pi --version 2>/dev/null)" && [ -n "$version" ]; then
    ok "pi CLI installed (${version%%$'\n'*})"
  else
    bad "pi CLI found but --version failed"
  fi
else
  bad "pi CLI not on PATH — install Pi first (see README prerequisites)"
fi

if [ -d "$CODE_ROOT/pi-shared" ]; then
  ok "pi-shared source present"
  SETTINGS="$AGENT_DIR/settings.json"
  if python3 - "$SETTINGS" "$CODE_ROOT/pi-shared" <<'PY'
import json, sys
from pathlib import Path
try:
    settings, package = Path(sys.argv[1]).expanduser(), Path(sys.argv[2]).resolve()
    data = json.loads(settings.read_text())
    packages = data.get('packages', [])
    if not isinstance(packages, list):
        raise ValueError('packages must be an array')
    for entry in packages:
        source = entry.get('source') if isinstance(entry, dict) else entry
        if isinstance(source, str) and (settings.parent / Path(source).expanduser()).resolve() == package:
            sys.exit(0)
except (OSError, ValueError, TypeError, AttributeError):
    pass
sys.exit(1)
PY
  then
    ok "pi-shared package configured in $SETTINGS (resource loading not tested)"
    if [ ! -x "$CODE_ROOT/pi-shared/bin/pi-shared-check-deps" ]; then
      bad "pi-shared dependency checker missing"
    elif "$CODE_ROOT/pi-shared/bin/pi-shared-check-deps"; then
      ok "pi-shared declared runtime dependencies resolve (extension execution not tested)"
    else
      bad "pi-shared dependency resolution failed"
    fi
  else
    bad "pi-shared not configured as the expected local package, or invalid settings: $SETTINGS"
  fi
else
  bad "pi-shared missing under $CODE_ROOT"
fi

# These module-owned checks understand persisted ports and use only local
# health/readiness endpoints (search also checks MCP tools/list, never tools/call).
check_service model-gateway "$CODE_ROOT/model-gateway/bin/model-gateway" \
  "service identity/liveness verified; model catalog, provider credentials and inference NOT tested"
check_service local_web_search "$CODE_ROOT/local_web_search/scripts/local-search" \
  "local readiness and MCP tool inventory verified; Brave provider request NOT tested"

for name in "${MODULES[@]:-}"; do
  case "$name" in
    ''|pi-shared|model-gateway|local_web_search) ;;
    *) skip "$name has no built-in readiness check; use an explicitly selected overlay doctor" ;;
  esac
done

for dir in "${OVERLAYS[@]:-}"; do
  [ -n "$dir" ] || continue
  if [ ! -d "$dir" ]; then
    bad "Selected overlay missing: $dir"
  elif [ -x "$dir/bin/doctor" ]; then
    echo "selected overlay: $dir"
    "$dir/bin/doctor" || bad "Overlay doctor failed: $dir"
  else
    skip "Selected overlay has no executable bin/doctor: $dir"
  fi
done

skip "End-to-end Pi/model/browser execution not tested; successful checks are not full runtime readiness"
exit "$FAIL"
