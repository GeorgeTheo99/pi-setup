#!/usr/bin/env python3
"""Check selected modules/profiles without shell startup, repair, or model calls.

Without --module, check known modules present under the code root. Overlay code
runs only when explicitly named. Extension registration executes through Pi's
SDK, just as at startup. --smoke-model ALIAS opts into one billable completion.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import subprocess
import sys


class Doctor:
    def __init__(self):
        self.failed = False

    def ok(self, message):
        print(f"  OK    {message}")

    def bad(self, message):
        self.failed = True
        print(f"  FAIL  {message}")

    def warn(self, message):
        print(f"  WARN  {message}")

    def command(self, argv, *, timeout=90, optional=False, required_line=None, require_output=False, env=None):
        try:
            process = subprocess.Popen(argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       start_new_session=True, env=env)
            try:
                out, err = process.communicate(timeout=timeout)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.communicate()
                raise
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.bad(f"Cannot complete {shlex.join(map(str, argv))}: {exc}")
            return False
        text = (out + err).strip()
        if optional and process.returncode == 2:
            self.warn(text or f"Optional capability unavailable: {argv[0]}")
            return False
        if process.returncode != 0:
            self.bad(f"Check exited {process.returncode}: {shlex.join(map(str, argv))}")
            if text:
                print(text[-6000:])
            return False
        if require_output and not out.strip():
            self.bad(f"Command returned no output: {shlex.join(map(str, argv))}")
            return False
        if required_line is not None and required_line not in [line.strip() for line in out.splitlines()]:
            self.bad(f"Command completed but did not return the expected response {required_line!r}")
            return False
        if text:
            print(text[-6000:])
        return True


def package_configured(settings, package):
    data = json.loads(settings.read_text())
    if not isinstance(data, dict) or not isinstance(data.get("packages", []), list):
        raise ValueError("settings must be an object with a packages array")
    for entry in data.get("packages", []):
        source = entry.get("source") if isinstance(entry, dict) else entry
        if isinstance(source, str) and (settings.parent / Path(source).expanduser()).resolve() == package:
            return True
    return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--module", action="append", default=[], metavar="NAME")
    parser.add_argument("--overlay", action="append", default=[], metavar="DIRECTORY")
    parser.add_argument("--smoke-model", metavar="ALIAS")
    parser.add_argument("--require-catalog", action="store_true",
                        help="Require generated launchers/model profile even on a fresh direct-provider setup")
    args = parser.parse_args()
    if "" in args.module or "" in args.overlay:
        parser.error("--module and --overlay require nonempty values")
    args.overlay = [Path(value) for value in args.overlay]
    home = Path.home()
    root = Path(os.environ.get("PI_SETUP_CODE_ROOT", home / "local_code")).expanduser().resolve()
    agent = Path(os.environ.get("PI_CODING_AGENT_DIR") or os.environ.get("PI_SHARED_AGENT_DIR")
                 or home / ".pi/agent").expanduser().resolve()
    shared = root / "pi-shared"
    doctor = Doctor()

    def selected(name):
        return not args.module or name in args.module

    def service(name, checker, evidence):
        if not selected(name):
            doctor.warn(f"{name} not selected")
            return False
        if not (root / name).is_dir():
            if args.module:
                doctor.bad(f"{name} selected but missing")
            else:
                doctor.warn(f"{name} not installed")
            return False
        doctor.ok(f"{name} source present (not proof of installation or readiness)")
        if not checker.is_file() or not os.access(checker, os.X_OK):
            doctor.bad(f"{name} read-only verifier missing: {checker}")
        elif doctor.command([str(checker), "verify"]):
            doctor.ok(f"{name}: {evidence}")
        else:
            doctor.bad(f"{name} verification failed; run: {checker} verify")
        return True

    print("pi-setup doctor (no provider calls unless --smoke-model is selected)")
    if not shutil.which("pi"):
        doctor.bad("Pi CLI is not on PATH. Install Pi first; see pi-setup README prerequisites.")
    elif not doctor.command(["pi", "--version"], timeout=15, require_output=True):
        doctor.bad("pi CLI found but --version failed")

    checker = shared / "bin/pi-shared-check-deps"
    probe = shared / "bin/pi-profile-check"
    if not shared.is_dir():
        doctor.bad(f"pi-shared missing under {root}")
    else:
        doctor.ok("pi-shared source present")
        settings = agent / "settings.json"
        try:
            configured = package_configured(settings, shared.resolve())
        except (OSError, ValueError, TypeError, RuntimeError):
            configured = False
        if not configured:
            doctor.bad(f"pi-shared not configured as the expected local package, or invalid settings: {settings}")
        else:
            doctor.ok(f"pi-shared package configured in {settings} (resource loading checked separately below)")
            if not all(path.is_file() and os.access(path, os.X_OK) for path in (checker, probe)):
                doctor.bad(f"Missing pi-shared health helpers. Repair: {shared / 'install.sh'}")
            else:
                if doctor.command([str(checker)]):
                    doctor.ok("pi-shared declared runtime dependencies resolve")
                else:
                    doctor.bad("pi-shared dependency resolution failed")
                doctor.command([str(probe), "--agent-dir", str(agent), "--expect-package", str(shared)])

    # Module-owned verifiers honor persisted ports; no fixed HTTP /health fallback.
    gateway = root / "model-gateway"
    gateway_selected = service("model-gateway", gateway / "bin/model-gateway",
                              "service identity/liveness verified; provider credentials and inference NOT tested")
    service("local_web_search", root / "local_web_search/scripts/local-search",
            "local readiness and MCP tool inventory verified; Brave provider request NOT tested")

    launchers = home / ".pi/generated/pi-launchers.zsh"
    bootstrap_launchers = False
    if launchers.is_file():
        try:
            bootstrap_launchers = launchers.read_text().startswith(
                "# Generated by pi-shared/bin/pi-catalog — do not hand-edit.\n"
                "# Pi catalog state: unconfigured (management-only).\n")
        except (OSError, UnicodeError) as exc:
            doctor.bad(f"Cannot inspect generated launcher state: {exc}")
    catalog_selected = (launchers.exists() or (home / ".pi-omlx/agent/settings.json").exists())
    bootstrap_required = os.environ.get("PI_SHARED_BOOTSTRAP_LAUNCHERS") == "1"
    if args.require_catalog or bootstrap_required or (gateway_selected and catalog_selected):
        if not launchers.is_file():
            doctor.bad(f"Missing launchers: {launchers}. Repair: rerun the overlay catalog hook.")
        elif not shutil.which("zsh"):
            doctor.bad("zsh is required for the generated model launchers")
        else:
            syntax_ok = doctor.command(["zsh", "-n", str(launchers)], timeout=10)
            if os.environ.get("PI_SETUP_NO_SHELL_RC") == "1":
                doctor.warn(f"Shell integration opted out; source {launchers} before using model launchers")
            else:
                rc = Path(os.environ.get("PI_SETUP_ZSHRC", home / ".zshrc")).expanduser()
                try:
                    lines = rc.read_text().splitlines() if rc.is_file() else []
                    hooked = any(not line.lstrip().startswith("#") and "pi-launchers.zsh" in line
                                 and ("source " in line or ". " in line) for line in lines)
                except (OSError, ValueError) as exc:
                    doctor.bad(f"Cannot inspect launcher hook in {rc}: {exc}")
                    hooked = False
                if not hooked:
                    doctor.bad(f"No launcher hook in {rc}. Repair: rerun pi-setup/install.sh")
                elif syntax_ok:
                    doctor.ok("Launcher syntax and shell hook configured (shell startup not executed)")
        if probe.is_file():
            argv = [str(probe), "--agent-dir", str(home / ".pi-omlx/agent"),
                    "--expect-package", str(shared)]
            if args.require_catalog or not bootstrap_launchers:
                argv += ["--require-models"]
            else:
                doctor.warn("Gateway catalog unconfigured; management/direct launchers are available, not gateway models")
            # Do not impose an unrelated sibling overlay on the generated profile.
            for overlay in args.overlay:
                if overlay.expanduser().resolve() == (root / "pi-databricks").resolve():
                    argv += ["--expect-package", str(overlay.expanduser().resolve())]
            doctor.command(argv)
    elif gateway_selected:
        doctor.warn("Generated model catalog not selected; direct Pi provider configuration remains available")

    if not selected("browser-worker"):
        doctor.warn("browser-worker not selected")
    else:
        browser = shared / "bin/pi-browser-check"
        worker_root = root / "browser-worker"
        worker = worker_root / "scripts/browser-worker"
        browser_selected = None
        try:
            research_path = home / ".pi/research/config.json"
            research = json.loads(research_path.read_text()) if research_path.exists() else {}
            if not isinstance(research, dict):
                raise ValueError("research config must be an object")
            enabled = research.get("browserWorkerEnabled", True)
            if not isinstance(enabled, bool):
                raise ValueError("browserWorkerEnabled must be boolean")
            browser_selected = enabled
        except (OSError, ValueError) as exc:
            doctor.bad(f"Invalid browser selection configuration: {exc}")
        installed_worker_selected = worker_root.exists() and browser_selected is True
        if args.module and not worker_root.is_dir():
            doctor.bad("browser-worker selected but missing")
        if installed_worker_selected:
            if not worker.is_file() or not os.access(worker, os.X_OK):
                doctor.bad(f"Selected browser-worker control script is missing/non-executable; restore the checkout at {worker_root} and rerun the installer")
            else:
                # This pinned operator bootstraps Python even for `verify`.
                # Fail before invoking it when that prerequisite is absent;
                # diagnostics must not silently provision an interpreter.
                offline = {**os.environ, "UV_PYTHON_DOWNLOADS": "never", "UV_OFFLINE": "true"}
                if not shutil.which("uv"):
                    doctor.bad("Browser verification requires installed uv/Python 3.12; run the explicit browser-worker installer to provision them")
                elif doctor.command(["uv", "python", "find", "--no-python-downloads", "3.12"],
                                    timeout=15, require_output=True, env=offline):
                    doctor.command([str(worker), "verify"], timeout=90, env=offline)
                else:
                    doctor.bad("Browser Python 3.12 prerequisite unavailable; worker operator was not invoked (no provisioning)")
        if browser.is_file():
            doctor.command([sys.executable, str(browser)], timeout=10, optional=not installed_worker_selected)
        elif installed_worker_selected:
            doctor.bad("Browser readiness helper missing; update pi-shared and retry")
        elif browser_selected is False:
            doctor.warn("DISABLED: browser-worker is not selected; browser readiness helper missing")
        else:
            doctor.warn("Browser readiness helper missing; public browser capability has not been verified")

    for name in args.module:
        if name not in {"pi-shared", "model-gateway", "local_web_search", "browser-worker"}:
            doctor.warn(f"{name} has no built-in readiness check; use an explicitly selected overlay doctor")
    for overlay in args.overlay:
        overlay = overlay.expanduser().resolve()
        check = overlay / "bin/doctor"
        if not overlay.is_dir():
            doctor.bad(f"Selected overlay missing: {overlay}")
        elif check.is_file() and os.access(check, os.X_OK):
            print(f"selected overlay: {overlay}")
            if not doctor.command([str(check)], timeout=120):
                doctor.bad(f"Overlay doctor failed: {overlay}")
        else:
            doctor.warn(f"Selected overlay has no executable bin/doctor: {overlay}")

    if args.smoke_model:
        if not re.fullmatch(r"[a-zA-Z0-9_-]+", args.smoke_model):
            doctor.bad("--smoke-model must be a launcher alias (letters, numbers, _ or -)")
        elif not launchers.is_file():
            doctor.bad("Cannot smoke a model before launchers are installed")
        else:
            doctor.command(["zsh", "-f", "-c", 'source "$1"; "$2" --no-tools -p "Reply with exactly PI_OK"',
                            "doctor", str(launchers), f"pi-{args.smoke_model}"], timeout=180, required_line="PI_OK")
    doctor.warn("Browser execution and fresh interactive shell not tested; successful checks are not full runtime readiness")
    return int(doctor.failed)


if __name__ == "__main__":
    sys.exit(main())
