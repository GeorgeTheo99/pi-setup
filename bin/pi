#!/usr/bin/env python3
"""Package bootstrap: managed bare updates, stock Pi or trusted shared launcher."""
import json
import os
from pathlib import Path
import stat
import sys


def private_json(path, *, private=True):
    for parent in (path.parent, path.parent.parent):
        info = parent.lstat()
        if stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise ValueError("unsafe configuration directory")
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
            or info.st_mode & (0o077 if private else 0o022) or info.st_nlink != 1 or info.st_size > 65536):
        raise ValueError("configuration must be an owner-only regular file")
    return json.loads(path.read_text())


def absolute(value):
    if not isinstance(value, str) or not value or any(c in value for c in "\0\r\n") or not Path(value).is_absolute():
        raise ValueError("configuration paths must be absolute")
    return Path(value)


def main():
    argv = sys.argv[1:]
    if argv == ["update"]:
        # Use this installation's updater, never PATH or a configured model alias.
        # It owns receipt validation and can repair an unavailable stock runtime.
        updater = Path(__file__).resolve().with_name("pi-shared")
        if (not updater.is_file() or not os.access(updater, os.X_OK)
                or updater.resolve() == Path(__file__).resolve()):
            raise ValueError("packaged pi-shared updater is unavailable; repair the owning installation")
        print("pi update: running pi-shared update (Pi runtime and saved modules).", file=sys.stderr, flush=True)
        os.execv(str(updater), [str(updater), "update"])
    upstream = absolute(os.environ.get("PI_UPSTREAM_BIN"))
    if not upstream.is_file() or not os.access(upstream, os.X_OK) or upstream.resolve() == Path(__file__).resolve():
        raise ValueError("PI_UPSTREAM_BIN must identify the executable stock Pi runtime")
    receipt = Path.home() / ".config/pi-shared/setup.json"
    shared = None
    if receipt.exists() or receipt.is_symlink():
        data = private_json(receipt)
        if (not isinstance(data, dict) or data.get("version") not in (1, 2)
                or data.get("status") not in ("incomplete", "module-checks-passed")
                or not isinstance(data.get("modules"), list) or "pi-shared" not in data["modules"]):
            raise ValueError("invalid setup receipt; repair with pi-shared setup")
        shared = absolute(data.get("code_root")) / "pi-shared"
        if "cli_file" in data:
            os.environ.setdefault("PI_LAUNCHER_CONFIG", str(absolute(data["cli_file"])))
        if data.get("mode") == "direct":
            # Native auth/models/packages live in the profile selected by setup.
            # Explicit caller profiles still win; gateway modes remain unchanged.
            os.environ.setdefault("PI_CODING_AGENT_DIR", str(absolute(data.get("agent_dir"))))
    else:
        # The conventional path alone is not authority to execute a checkout.
        # Source installations can explicitly configure it as their Pi package.
        candidate = Path.home() / ".local/share/pi-shared/modules/pi-shared"
        settings = Path.home() / ".pi/agent/settings.json"
        if settings.exists():
            try:
                data = private_json(settings, private=False)
            except (OSError, ValueError):
                data = {}  # Unconfigured/unsafe profile is not authority to delegate.
            entries = data.get("packages", []) if isinstance(data, dict) else []
            for entry in entries if isinstance(entries, list) else []:
                source = entry.get("source") if isinstance(entry, dict) else entry
                if isinstance(source, str) and (settings.parent / Path(source).expanduser()).resolve() == candidate.resolve():
                    shared = candidate
    launcher = shared / "bin/pi-launch" if shared else None
    if launcher and launcher.is_file() and os.access(launcher, os.X_OK):
        # Setup chose this checkout. Never search cwd, PATH or unrelated siblings.
        for path in (shared.parent, shared, shared / "bin", launcher):
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
                raise ValueError("unsafe shared launcher; repair the configured checkout")
        if argv[:1] == ["models"]:
            # New shared launchers own the command and its flags. Older releases
            # must still receive management flags, never a potential model prompt.
            capabilities_path = shared / "lib/pi-launcher-capabilities.json"
            capabilities = (private_json(capabilities_path, private=False)
                            if capabilities_path.exists() or capabilities_path.is_symlink() else {})
            if not isinstance(capabilities, dict):
                raise ValueError("invalid shared launcher capabilities; run pi-shared update")
            version = capabilities.get("modelsCommand")
            if type(version) is not int or version != 1:
                if argv == ["models"]:
                    argv = ["--launcher-list"]
                elif argv[1:] in (["--help"], ["-h"]):
                    argv = ["--launcher-help"]
                else:
                    raise ValueError("Shared launcher needs pi-shared update for pi models options")
        os.execv(str(launcher), [str(launcher), *argv])
    if argv[:1] == ["models"] or (argv and argv[0].startswith("--launcher-")):
        raise ValueError("launcher support is not installed; run pi-shared setup (or pi-shared update for an existing installation)")
    os.execv(str(upstream), [str(upstream), *argv])


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"pi: {exc}", file=sys.stderr)
        sys.exit(1)
